      "steps": [
        {
          "step_number": 1,
          "instruction": "按食材清单备好鲤鱼、葱、姜；肉类或水产用厨房纸擦干，处理后清洗双手、刀具和砧板。",
          "safety_note": "生肉和水产不要在水槽中冲洗，处理后清洁接触面。"
        },
        {
          "step_number": 2,
          "instruction": "鲤鱼两侧各划数刀，抹 3 克盐后均匀拍上 50 克淀粉。",
          "safety_note": "处理生鱼后清洗双手、刀具和砧板。"
        },
        {
          "step_number": 3,
          "instruction": "炒锅加入 60 毫升食用油，中火把鱼两面各煎 6 分钟，至鱼肉完全不透明后盛出。",
          "duration_seconds": 720,
          "heat_level": "中火",
          "safety_note": "鱼身必须擦干，翻面时用锅铲托稳。"
        },
        {
          "step_number": 4,
          "instruction": "锅中留 5 毫升油，加入葱、姜、番茄酱、香醋、白糖、生抽和 80 毫升清水，小火煮 2 分钟。",
          "duration_seconds": 120,
          "heat_level": "小火"
        },
        {
          "step_number": 5,
          "instruction": "将糖醋汁均匀淋在煎熟的鲤鱼上。",
          "safety_note": "确认动物性食材中心完全熟透、无粉红或透明部分。"
        }
      ]
