  "recipes": [
    {
      "recipe_id": "htc_steamed_sea_bass",
      "name": "清蒸鲈鱼",
      "default_servings": 2,
      "estimated_time_minutes": 22,
      "difficulty": "中等",
      "equipment": [
        "蒸锅"
      ],
      "summary": "突出鱼肉鲜嫩口感的基础清蒸鲈鱼。",
      "source_key": "howtocook",
      "source_name": "HowToCook（人工校订）",
      "source_revision": "c05758fa661ac4efa0361a987b700a351a22159b",
      "source_path": "dishes/aquatic/清蒸鲈鱼/清蒸鲈鱼.md",
      "source_url": "https://github.com/Anduin2017/HowToCook/blob/c05758fa661ac4efa0361a987b700a351a22159b/dishes/aquatic/清蒸鲈鱼/清蒸鲈鱼.md",
      "license": "Unlicense",
      "ingredients": [
        {
          "name": "鲈鱼",
          "amount": "500 克"
        },
        {
          "name": "姜",
          "amount": "15 克"
        },
        {
          "name": "葱",
          "amount": "25 克"
        },
        {
          "name": "料酒",
          "amount": "10 毫升"
        },
        {
          "name": "蒸鱼豉油",
          "amount": "15 毫升"
        },
        {
          "name": "食用油",
          "amount": "12 毫升"
        },
        {
          "name": "盐",
          "amount": "2 克"
        },
        {
          "name": "清水",
          "amount": "1500 毫升"
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "instruction": "请摊主处理好鲈鱼；回家后用厨房纸擦干表面，在鱼身两侧各划两刀，抹 2 克盐和 10 毫升料酒，姜切片，葱切丝。",
          "safety_note": "处理生鱼后清洗双手、刀具、砧板和台面。"
        },
        {
          "step_number": 2,
          "instruction": "鱼盘铺一半姜片和葱丝，放上鲈鱼，再把剩余姜片放在鱼身上。"
        },
        {
          "step_number": 3,
          "instruction": "蒸锅加入 1500 毫升清水烧开，放入鱼盘，大火蒸 9 分钟。",
          "duration_seconds": 540,
          "heat_level": "大火",
          "safety_note": "开盖时让蒸汽远离脸和手。"
        },
        {
          "step_number": 4,
          "instruction": "关火后焖 2 分钟，确认鱼肉完全不透明且能用筷子轻松拨开；未熟时继续蒸 2 分钟。",
          "duration_seconds": 120,
          "safety_note": "鱼肉未熟透时不要试吃。"
        },
        {
          "step_number": 5,
          "instruction": "倒掉盘中多余汁水，淋 15 毫升蒸鱼豉油并放葱丝；另锅把 12 毫升食用油加热 40 秒后淋在葱丝上。",
          "duration_seconds": 40,
          "heat_level": "中火",
          "safety_note": "淋热油时保持手和脸远离鱼盘。"
        }
      ]
    },
    {
      "recipe_id": "htc_blanch_shrimp",
      "name": "白灼虾",
      "default_servings": 2,
      "estimated_time_minutes": 15,
      "difficulty": "简单",
      "equipment": [
        "汤锅"
      ],
      "summary": "火候短、保留虾肉清甜的白灼做法。",
      "source_key": "howtocook",
      "source_name": "HowToCook（人工校订）",
      "source_revision": "c05758fa661ac4efa0361a987b700a351a22159b",
      "source_path": "dishes/aquatic/白灼虾/白灼虾.md",
      "source_url": "https://github.com/Anduin2017/HowToCook/blob/c05758fa661ac4efa0361a987b700a351a22159b/dishes/aquatic/白灼虾/白灼虾.md",
      "license": "Unlicense",
      "ingredients": [
        {
          "name": "鲜虾",
          "amount": "350 克"
        },
        {
          "name": "姜",
          "amount": "10 克"
        },
        {
          "name": "葱",
          "amount": "10 克"
        },
        {
          "name": "蒜",
          "amount": "2 瓣"
        },
        {
          "name": "料酒",
          "amount": "10 毫升"
        },
        {
          "name": "生抽",
          "amount": "15 毫升"
        },
        {
          "name": "香醋",
          "amount": "10 毫升"
        },
        {
          "name": "香油",
          "amount": "3 毫升"
        },
        {
          "name": "清水",
          "amount": "1000 毫升"
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "instruction": "剪去鲜虾长须并去虾线，用厨房纸吸去表面水分；姜切片，葱切段，蒜切末。",
          "safety_note": "处理生虾后清洗双手、剪刀、砧板和台面。"
        },
        {
          "step_number": 2,
          "instruction": "将蒜末、15 毫升生抽、10 毫升香醋和 3 毫升香油调成蘸汁。"
        },
        {
          "step_number": 3,
          "instruction": "汤锅加入 1000 毫升清水、姜、葱和 10 毫升料酒，大火烧开。",
          "heat_level": "大火"
        },
        {
          "step_number": 4,
          "instruction": "放入鲜虾，大火煮 3 分钟，直到虾身弯曲、外壳变红且虾肉完全不透明。",
          "duration_seconds": 180,
          "heat_level": "大火",
          "safety_note": "虾肉仍透明时继续加热，不要试吃。"
        },
        {
          "step_number": 5,
          "instruction": "用漏勺捞出鲜虾并沥水，配蘸汁食用。",
          "safety_note": "捞取时防止沸水烫伤。"
        }
      ]
    },
