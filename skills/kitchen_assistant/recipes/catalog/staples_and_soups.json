          "amount": "20 克"
        },
        {
          "name": "姜",
          "amount": "10 克"
        },
        {
          "name": "生抽",
          "amount": "10 毫升"
        },
        {
          "name": "盐",
          "amount": "2 克"
        },
        {
          "name": "清水",
          "amount": "1500 毫升"
        },
        {
          "name": "香油",
          "amount": "8 毫升"
        }
      ],
      "notes": [
        "用量、油盐、火力和食品安全说明已按本项目规范重新校订。"
      ],
      "steps": [
        {
          "step_number": 1,
          "instruction": "按食材清单备好饺子皮、猪肉馅、大白菜、葱、姜；肉类或水产用厨房纸擦干，处理后清洗双手、刀具和砧板。",
          "safety_note": "生肉和水产不要在水槽中冲洗，处理后清洁接触面。"
        },
        {
          "step_number": 2,
          "instruction": "大白菜切碎后挤去部分水分，与 400 克猪肉馅、葱、姜、生抽、盐和香油顺一个方向搅拌 3 分钟。",
          "duration_seconds": 180
        },
        {
          "step_number": 3,
          "instruction": "每张饺子皮中央放约 15 克馅，对折并捏紧边缘，依次包完。",
          "safety_note": "生肉馅接触过的碗和工具不要再接触熟食。"
        },
        {
          "step_number": 4,
          "instruction": "汤锅加入 1500 毫升清水烧开，分批放入饺子并轻推防粘；水再次沸腾后中火煮 8 分钟。",
          "duration_seconds": 480,
          "heat_level": "中火"
        },
        {
          "step_number": 5,
          "instruction": "捞出一个饺子切开，确认肉馅完全变色且汁液清澈后再全部捞出。",
          "safety_note": "确认动物性食材中心完全熟透、无粉红或透明部分。"
        }
      ]
    },
