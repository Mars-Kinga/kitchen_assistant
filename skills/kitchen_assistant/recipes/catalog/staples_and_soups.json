    {
      "recipe_id": "htc_yangzhou_fried_rice",
      "name": "扬州炒饭",
      "default_servings": 2,
      "estimated_time_minutes": 25,
      "difficulty": "中等",
      "equipment": [
        "炒锅"
      ],
      "summary": "米粒分明、鸡蛋鲜虾和蔬菜丰富的扬州炒饭。",
      "source_key": "howtocook",
      "source_name": "HowToCook（人工校订）",
      "source_revision": "c05758fa661ac4efa0361a987b700a351a22159b",
      "source_path": "dishes/staple/扬州炒饭/扬州炒饭.md",
      "source_url": "https://github.com/Anduin2017/HowToCook/blob/c05758fa661ac4efa0361a987b700a351a22159b/dishes/staple/扬州炒饭/扬州炒饭.md",
      "license": "Unlicense",
      "ingredients": [
        {
          "name": "熟米饭",
          "amount": "350 克"
        },
        {
          "name": "鸡蛋",
          "amount": "2 个"
        },
        {
          "name": "鲜虾仁",
          "amount": "100 克"
        },
        {
          "name": "火腿",
          "amount": "80 克"
        },
        {
          "name": "豌豆",
          "amount": "50 克"
        },
        {
          "name": "胡萝卜",
          "amount": "50 克"
        },
        {
          "name": "玉米粒",
          "amount": "50 克"
        },
        {
          "name": "葱",
          "amount": "10 克"
        },
        {
          "name": "食用油",
          "amount": "20 毫升"
        },
        {
          "name": "盐",
          "amount": "3 克"
        },
        {
          "name": "清水",
          "amount": "800 毫升"
        }
      ],
      "notes": [
        "熟米饭应冷藏不超过一天并彻底复热。"
      ],
      "steps": [
        {
          "step_number": 1,
          "instruction": "火腿和胡萝卜切丁，葱切末，2 个鸡蛋打散；鲜虾仁用厨房纸吸干表面水分。",
          "safety_note": "处理生虾后清洗双手、刀具和砧板。"
        },
        {
          "step_number": 2,
          "instruction": "小锅加入 800 毫升清水烧开，放入豌豆、胡萝卜和玉米粒焯 2 分钟后沥干。",
          "duration_seconds": 120,
          "heat_level": "大火"
        },
        {
          "step_number": 3,
          "instruction": "炒锅加入 8 毫升食用油，中火把虾仁炒 3 分钟，直到虾肉完全不透明后盛出。",
          "duration_seconds": 180,
          "heat_level": "中火",
          "safety_note": "虾仁未熟透时不要试吃。"
        },
        {
          "step_number": 4,
          "instruction": "锅中加入 6 毫升食用油，中火倒入蛋液炒 1 分钟至凝固后盛出。",
          "duration_seconds": 60,
          "heat_level": "中火"
        },
        {
          "step_number": 5,
          "instruction": "锅中加入剩余 6 毫升食用油，放入熟米饭，大火翻炒 3 分钟至米饭整体滚烫。",
          "duration_seconds": 180,
          "heat_level": "大火",
          "safety_note": "隔夜米饭必须彻底加热至整体冒热气。"
        },
        {
          "step_number": 6,
          "instruction": "加入虾仁、鸡蛋、火腿、蔬菜、葱末和 3 克盐，大火翻炒 2 分钟后关火。",
          "duration_seconds": 120,
          "heat_level": "大火"
        }
      ]
    },
    {
      "recipe_id": "htc_scallion_oil_noodles",
      "name": "葱油拌面",
      "default_servings": 2,
      "estimated_time_minutes": 22,
      "difficulty": "简单",
      "equipment": [
        "汤锅",
        "炒锅"
      ],
      "summary": "葱香浓郁、酱汁咸甜平衡的快手拌面。",
      "source_key": "howtocook",
      "source_name": "HowToCook（人工校订）",
      "source_revision": "c05758fa661ac4efa0361a987b700a351a22159b",
      "source_path": "dishes/staple/葱油拌面.md",
      "source_url": "https://github.com/Anduin2017/HowToCook/blob/c05758fa661ac4efa0361a987b700a351a22159b/dishes/staple/葱油拌面.md",
      "license": "Unlicense",
      "ingredients": [
        {
          "name": "面条",
          "amount": "200 克"
        },
        {
          "name": "小葱",
          "amount": "60 克"
        },
        {
          "name": "食用油",
          "amount": "40 毫升"
        },
        {
          "name": "生抽",
          "amount": "25 毫升"
        },
        {
          "name": "老抽",
          "amount": "5 毫升"
        },
        {
          "name": "白糖",
          "amount": "6 克"
        },
        {
          "name": "清水",
          "amount": "1550 毫升"
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "instruction": "小葱洗净并彻底擦干，切成 5 厘米段；将 25 毫升生抽、5 毫升老抽、6 克白糖和 50 毫升清水调匀。"
        },
        {
          "step_number": 2,
          "instruction": "炒锅加入 40 毫升食用油和葱段，小火煎 8 分钟，直到葱段呈深绿色但没有焦黑。",
          "duration_seconds": 480,
          "heat_level": "小火",
          "safety_note": "葱段必须擦干，防止热油飞溅。"
        },
        {
          "step_number": 3,
          "instruction": "关火静置 30 秒，倒入调好的酱汁，再开小火煮 1 分钟后关火。",
          "duration_seconds": 90,
          "heat_level": "小火",
          "safety_note": "酱汁含水，倒入热油前必须先关火。"
        },
        {
          "step_number": 4,
          "instruction": "汤锅加入 1500 毫升清水烧开，放入 200 克面条，按包装建议时间煮熟后沥干。",
          "heat_level": "大火"
        },
        {
          "step_number": 5,
          "instruction": "把面条分入两碗，每碗加入一半葱油酱汁并拌匀。"
        }
      ]
    },
