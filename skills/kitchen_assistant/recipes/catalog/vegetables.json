      "source_url": "https://github.com/Anduin2017/HowToCook/blob/c05758fa661ac4efa0361a987b700a351a22159b/dishes/vegetable_dish/红烧茄子.md",
      "license": "Unlicense",
      "ingredients": [
        {
          "name": "茄子",
          "amount": "400 克"
        },
        {
          "name": "青椒",
          "amount": "80 克"
        },
        {
          "name": "番茄",
          "amount": "150 克"
        },
        {
          "name": "蒜",
          "amount": "3 瓣"
        },
        {
          "name": "食用油",
          "amount": "25 毫升"
        },
        {
          "name": "生抽",
          "amount": "15 毫升"
        },
        {
          "name": "白糖",
          "amount": "5 克"
        },
        {
          "name": "淀粉",
          "amount": "5 克"
        },
        {
          "name": "盐",
          "amount": "2 克"
        },
        {
          "name": "清水",
          "amount": "100 毫升"
        }
      ],
      "notes": [
        "用少油煎软代替原做法中的大量油炸。"
      ],
      "steps": [
        {
          "step_number": 1,
          "instruction": "茄子切滚刀块，青椒和番茄切块，蒜切末；将 15 毫升生抽、5 克白糖、5 克淀粉、2 克盐和 100 毫升清水调成料汁。"
        },
        {
          "step_number": 2,
          "instruction": "炒锅加入 20 毫升食用油，中火放入茄子煎炒 6 分钟，翻动至各面变软。",
          "duration_seconds": 360,
          "heat_level": "中火",
          "safety_note": "茄子下锅前擦干表面水分，避免热油飞溅。"
        },
        {
          "step_number": 3,
          "instruction": "加入剩余 5 毫升食用油、蒜末和番茄，中火翻炒 2 分钟至番茄出汁。",
          "duration_seconds": 120,
          "heat_level": "中火"
        },
        {
          "step_number": 4,
          "instruction": "加入青椒和调好的料汁，小火焖 3 分钟。",
          "duration_seconds": 180,
          "heat_level": "小火"
        },
        {
          "step_number": 5,
          "instruction": "转中火翻炒 1 分钟，待汤汁裹住茄子后关火。",
          "duration_seconds": 60,
          "heat_level": "中火"
        }
      ]
    },
