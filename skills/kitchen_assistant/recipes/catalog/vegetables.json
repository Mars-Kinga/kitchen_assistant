    {
      "recipe_id": "htc_hand_torn_cabbage",
      "name": "手撕包菜",
      "default_servings": 2,
      "estimated_time_minutes": 18,
      "difficulty": "简单",
      "equipment": [
        "炒锅"
      ],
      "summary": "包菜脆嫩、带五花肉香气的家常快炒。",
      "source_key": "howtocook",
      "source_name": "HowToCook（人工校订）",
      "source_revision": "c05758fa661ac4efa0361a987b700a351a22159b",
      "source_path": "dishes/vegetable_dish/手撕包菜/手撕包菜.md",
      "source_url": "https://github.com/Anduin2017/HowToCook/blob/c05758fa661ac4efa0361a987b700a351a22159b/dishes/vegetable_dish/手撕包菜/手撕包菜.md",
      "license": "Unlicense",
      "ingredients": [
        {
          "name": "包菜",
          "amount": "350 克"
        },
        {
          "name": "五花肉",
          "amount": "120 克"
        },
        {
          "name": "小米辣",
          "amount": "2 个",
          "optional": true
        },
        {
          "name": "姜",
          "amount": "6 克"
        },
        {
          "name": "蒜",
          "amount": "2 瓣"
        },
        {
          "name": "食用油",
          "amount": "20 毫升"
        },
        {
          "name": "料酒",
          "amount": "5 毫升"
        },
        {
          "name": "生抽",
          "amount": "10 毫升"
        },
        {
          "name": "香醋",
          "amount": "5 毫升"
        },
        {
          "name": "盐",
          "amount": "3 克"
        }
      ],
      "notes": [
        "原菜谱油量已按家常快炒场景下调。"
      ],
      "steps": [
        {
          "step_number": 1,
          "instruction": "包菜撕成约 5 厘米的片后沥干，五花肉用厨房纸擦干表面并切薄片，姜、蒜和小米辣切好。",
          "safety_note": "切配时保持手指与刀刃距离。"
        },
        {
          "step_number": 2,
          "instruction": "炒锅加入 10 毫升食用油，中火加热 30 秒，放入五花肉煸炒 3 分钟，直到肉片变色并微微卷起。",
          "duration_seconds": 180,
          "heat_level": "中火",
          "safety_note": "生猪肉必须炒到完全变色，热油飞溅时后退半步。"
        },
        {
          "step_number": 3,
          "instruction": "加入姜、蒜和小米辣翻炒 30 秒，再倒入 5 毫升料酒。",
          "duration_seconds": 30,
          "heat_level": "中火"
        },
        {
          "step_number": 4,
          "instruction": "转大火，加入包菜和剩余 10 毫升食用油，快速翻炒 2 分钟。",
          "duration_seconds": 120,
          "heat_level": "大火"
        },
        {
          "step_number": 5,
          "instruction": "加入 10 毫升生抽、5 毫升香醋和 3 克盐，翻炒 1 分钟至包菜断生后关火。",
          "duration_seconds": 60,
          "heat_level": "大火"
        }
      ]
    },
    {
      "recipe_id": "htc_braised_eggplant",
      "name": "家常红烧茄子",
      "default_servings": 2,
      "estimated_time_minutes": 25,
