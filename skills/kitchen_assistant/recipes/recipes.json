    "notes": [
      "热油和灶具请由使用者自行安全操作。",
      "少盐口味请在最后调味时少量添加。"
    ],
    "steps": [
      {
        "step_number": 1,
        "instruction": "把 2 个鸡蛋打入碗中，加一小撮盐后搅拌到蛋黄蛋清均匀。",
        "display_text": "步骤 1/7：打鸡蛋并搅拌",
        "robot_action": "encourage_gesture",
        "led_effect": "warm_white",
        "expression": "happy"
      },
      {
        "step_number": 2,
        "instruction": "把番茄洗净切块，注意刀具安全。",
        "display_text": "步骤 2/7：切番茄",
        "robot_action": "show_concern",
        "led_effect": "yellow",
        "expression": "alert",
        "safety_note": "切菜时请注意手指与刀具的距离。"
      },
      {
        "step_number": 3,
        "instruction": "先开中火预热空锅约 30 秒；锅温热后倒入 1 汤匙油，油在锅里能轻松流动时倒入蛋液。",
        "display_text": "步骤 3/7：热锅后倒油和蛋液",
        "robot_action": "nod",
        "led_effect": "yellow",
        "expression": "focused",
        "safety_note": "热油可能飞溅，请保持安全距离。"
      },
      {
        "step_number": 4,
        "instruction": "把鸡蛋快速炒到刚凝固、仍然嫩滑时盛出备用，不要炒得太老。",
        "display_text": "步骤 4/7：炒熟鸡蛋并盛出",
        "robot_action": "encourage_gesture",
        "led_effect": "green_dynamic",
        "expression": "happy"
      },
      {
        "step_number": 5,
        "instruction": "锅中补 1 茶匙油，倒入番茄，中火翻炒 2 到 3 分钟，直到番茄明显出汁。",
        "display_text": "步骤 5/7：补油后炒番茄出汁",
        "robot_action": "encourage_gesture",
        "led_effect": "green_dynamic",
        "expression": "focused"
      },
      {
        "step_number": 6,
        "instruction": "倒回鸡蛋，加入 1/4 茶匙盐；喜欢咸香可加 1 茶匙生抽，快速翻匀后尝味。",
        "display_text": "步骤 6/7：回锅调味翻匀",
        "robot_action": "nod",
        "led_effect": "warm_white",
        "expression": "happy"
      },
      {
        "step_number": 7,
        "instruction": "关火装盘；喜欢的话撒 1 汤匙葱花。确认关火后再离开灶台。",
        "display_text": "步骤 7/7：关火装盘",
        "robot_action": "high_five",
        "led_effect": "rainbow",
        "expression": "excited",
        "safety_note": "确认关火后再离开灶台。"
      }
    ],
    "summary": "经典家常番茄炒蛋，适合新手练习。",
    "difficulty": "简单",
